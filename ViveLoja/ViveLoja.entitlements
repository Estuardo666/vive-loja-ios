<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Resolved from VL_APS_ENVIRONMENT so a release build cannot ship a
	     sandbox entitlement while the app reports production tokens. -->
	<key>aps-environment</key>
	<string>$(VL_APS_ENVIRONMENT)</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:viveloja.com</string>
		<string>webcredentials:viveloja.com</string>
	</array>
</dict>
</plist>
